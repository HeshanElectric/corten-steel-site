# Public hostname used by Nginx server_name and Let's Encrypt paths.
DOMAIN=example.com

# Let's Encrypt registration email (used only when requesting certificates).
CERTBOT_EMAIL=admin@example.com

# MariaDB root password. Replace before any production deploy.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_k8nQ2vL9wP4xM7hC3

# WordPress database name and application user.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CHANGE_ME_WP_b6H5cT8fD1sA9uE2rY4

# WordPress database connection (host is the Compose service name).
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=CHANGE_ME_WP_b6H5cT8fD1sA9uE2rY4
WORDPRESS_TABLE_PREFIX=wp_

# Redis object cache (internal backend network only).
WP_REDIS_HOST=redis
WP_REDIS_PORT=6379

# Optional image overrides. Leave unset to pull from Docker Hub.
# In mainland China, Docker Hub (registry-1.docker.io) is often blocked or poisoned on IPv6.
# Use a mirror prefix, then recreate the stack: docker compose up -d
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27.5-alpine
WORDPRESS_IMAGE=docker.1panel.live/library/wordpress:6.8.3-php8.3-fpm
MARIADB_IMAGE=docker.1panel.live/library/mariadb:11.4
REDIS_IMAGE=docker.m.daocloud.io/library/redis:7.4.11-alpine
CERTBOT_IMAGE=docker.1panel.live/certbot/certbot:v5.8.0
